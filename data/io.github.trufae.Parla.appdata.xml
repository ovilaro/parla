<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.trufae.Parla</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0</project_license>
  <name>Parla</name>
  <summary>A Delta Chat client for GNOME</summary>
  <description>
    <p>Parla is a Delta Chat client for GNOME.</p>
    <p>Chat over email, decentralized and encrypted.</p>
  </description>
  <launchable type="desktop-id">io.github.trufae.Parla.desktop</launchable>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/trufae/parla/main/data/screenshots/welcome.png</image>
      <caption>Welcome</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/trufae/parla/main/data/screenshots/welcome-dark.png</image>
      <caption>Dark Theme</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/trufae/parla</url>
  <url type="bugtracker">https://github.com/trufae/parla/issues</url>
  <url type="vcs-browser">https://github.com/trufae/parla</url>
  <developer id="io.github.trufae">
    <name translate="no">pancake</name>
  </developer>
  <releases>
    <release version="0.4.0" date="2026-06-03">
      <description>
        <ul>
          <li>Media playback</li>
          <li>Better input focus</li>
          <li>Double ESC to cancel attachment</li>
          <li>Configurable tray icon</li>
          <li>Invite link creation and opening inside the app</li>
          <li>Faster and non-blocking history loading</li>
          <li>Label forwarded messages accordingly</li>
          <li>Tag forwarded messages</li>
          <li>Show notifications from all accounts</li>
          <li>Support custom background color and gradient</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-06-01">
      <description>
        <ul>
          <li>New icon and welcome screen</li>
          <li>Better jsonrpc download onboarding</li>
          <li>Allow to interrupt account creation before timeout</li>
        </ul>
      </description>
    </release>
    <release version="0.2.8" date="2026-05-20">
      <description>
        <ul>
          <li>Custom accent color</li>
          <li>Bubble chat/irc view</li>
          <li>Improved message reactions</li>
          <li>Select default profile</li>
          <li>Create channels</li>
          <li>Toggle sidebar with keyboard shortcut</li>
        </ul>
      </description>
    </release>
    <release version="0.2.6" date="2026-05-15">
      <description>
        <ul>
          <li>Show user cache and server quota stats</li>
          <li>Download and update chatmail jsonrpc server</li>
          <li>No longer depends on deltachat desktop by default</li>
        </ul>
      </description>
    </release>
    <release version="0.2.4" date="2026-04-30">
      <description>
        <ul>
          <li>Account creation</li>
          <li>Enter chat via invite link</li>
          <li>Manage relay profiles</li>
          <li>Discover new relays from contacts</li>
          <li>Profile lists available in the avatar circle</li>
          <li>Support import/export secondary device</li>
          <li>Prompt before destructive actions</li>
          <li>Next/prev picture with arrows</li>
        </ul>
      </description>
    </release>
    <release version="0.2.2" date="2026-04-22">
      <description>
        <ul>
          <li>Focusable conversation list</li>
          <li>Paste images from clipboard</li>
          <li>Add delivery indicators</li>
          <li>Add forward message action</li>
          <li>Improve delete experience</li>
          <li>Composebar with emoji-picker</li>
        </ul>
      </description>
    </release>
    <release version="0.2.1" date="2026-04-16">
      <description>
        <ul>
          <li>Add factory reset option in settings</li>
          <li>Custom path to the JSONRPC server</li>
          <li>Use ESC to focus the composebar</li>
          <li>Faster conversation loads</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-04-12">
      <description>
        <p>This is the very first release</p>
      </description>
    </release>
  </releases>
</component>
